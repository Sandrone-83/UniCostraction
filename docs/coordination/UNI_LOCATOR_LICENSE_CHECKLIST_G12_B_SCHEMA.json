{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unicostruction.local/schemas/UNI_LOCATOR_LICENSE_CHECKLIST_G12_B_SCHEMA.json",
  "title": "UniCostraction G12-B metadata-only locator and licence checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "checklist_id",
    "metadata_only",
    "observed_at",
    "source_commit",
    "scope",
    "summary",
    "records"
  ],
  "properties": {
    "$schema": {"const": "./UNI_LOCATOR_LICENSE_CHECKLIST_G12_B_SCHEMA.json"},
    "schema_version": {"const": "G12-B-locator-license-checklist"},
    "checklist_id": {"const": "G12-B-locator-license"},
    "metadata_only": {"const": true},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_commit": {"const": "5609b4eb965e4b45d4520a563f2403b1f9fce980"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_manifests", "record_scope", "excluded_payloads", "live_verification_policy", "promotion_policy"],
      "properties": {
        "input_manifests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "record_scope": {"type": "string", "minLength": 1},
        "excluded_payloads": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "live_verification_policy": {"type": "string", "minLength": 1},
        "promotion_policy": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "claim_ready_count", "legal_clearance_required_count", "by_locator_reachable_state", "by_official_context_state", "by_license_source_specific_state", "blocker_count"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "claim_ready_count": {"const": 0},
        "legal_clearance_required_count": {"type": "integer", "minimum": 0},
        "by_locator_reachable_state": {"$ref": "#/$defs/status_counts"},
        "by_official_context_state": {"$ref": "#/$defs/status_counts"},
        "by_license_source_specific_state": {"$ref": "#/$defs/status_counts"},
        "blocker_count": {"type": "integer", "minimum": 0}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_live", "observed_local", "blocked"],
      "properties": {
        "observed_live": {"type": "integer", "minimum": 0},
        "observed_local": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "live_check", "basis", "evidence_refs"],
      "properties": {
        "state": {"enum": ["observed_live", "observed_local", "blocked"]},
        "value": {"type": ["boolean", "null"]},
        "live_check": {"enum": ["passed", "blocked", "not_applicable"]},
        "basis": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "legal_clearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "state", "basis"],
      "properties": {
        "required": {"const": true},
        "state": {"const": "required"},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "codes", "reason", "promotion_forbidden"],
      "properties": {
        "state": {"const": "blocked"},
        "codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1},
        "promotion_forbidden": {"const": true}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_key", "manifest_path", "manifest_id", "source_record_id", "source_kind", "title", "locator_reachable_observed", "official_context_observed", "license_source_specific", "legal_clearance_required", "claim_ready", "blocker"],
      "properties": {
        "record_key": {"type": "string", "pattern": "^.+#[^#]+$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_id": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string", "minLength": 1},
        "source_kind": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "locator_reachable_observed": {"$ref": "#/$defs/observation"},
        "official_context_observed": {"$ref": "#/$defs/observation"},
        "license_source_specific": {"$ref": "#/$defs/observation"},
        "legal_clearance_required": {"$ref": "#/$defs/legal_clearance"},
        "claim_ready": {"const": false},
        "blocker": {"$ref": "#/$defs/blocker"}
      }
    }
  }
}
