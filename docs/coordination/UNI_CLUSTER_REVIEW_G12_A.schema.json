{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unicostruction.local/schemas/uni-cluster-review-g12a.v1.json",
  "title": "UniCostraction G12-A human component decision contract",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "input",
    "scope",
    "review_policy",
    "coverage",
    "review_queue",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "g12a.v1" },
    "tool": { "const": "tools/uni_cluster_review_g12_a.py" },
    "input": { "$ref": "#/$defs/input" },
    "scope": { "$ref": "#/$defs/scope" },
    "review_policy": { "$ref": "#/$defs/reviewPolicy" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "review_queue": {
      "type": "array",
      "minItems": 85,
      "maxItems": 85,
      "items": { "$ref": "#/$defs/component" }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "required": ["path", "schema_version", "component_count", "component_ids_sha256", "report_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "schema_version": { "const": "g11a.v1" },
        "component_count": { "const": 85 },
        "component_ids_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "report_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "decision_level",
        "initial_decision",
        "allowed_decisions",
        "human_review_required",
        "answers_read",
        "didactic_content_copied",
        "didactic_content_modified",
        "automatic_card_modification",
        "automatic_exam_modification",
        "automatic_merge_or_reject",
        "files_deleted",
        "source_of_truth"
      ],
      "properties": {
        "decision_level": { "const": "connected_component" },
        "initial_decision": { "const": null },
        "allowed_decisions": {
          "const": ["distinct", "merge_candidate", "reject_candidate", "needs_source_review"]
        },
        "human_review_required": { "const": true },
        "answers_read": { "const": false },
        "didactic_content_copied": { "const": false },
        "didactic_content_modified": { "const": false },
        "automatic_card_modification": { "const": false },
        "automatic_exam_modification": { "const": false },
        "automatic_merge_or_reject": { "const": false },
        "files_deleted": { "const": false },
        "source_of_truth": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewPolicy": {
      "type": "object",
      "required": [
        "evidence_ref_required_for_non_null_decision",
        "reviewer_required",
        "rationale_required",
        "null_initial_state_is_pending",
        "decision_is_not_an_action"
      ],
      "properties": {
        "evidence_ref_required_for_non_null_decision": { "const": true },
        "reviewer_required": { "const": true },
        "rationale_required": { "const": true },
        "null_initial_state_is_pending": { "const": true },
        "decision_is_not_an_action": { "const": true }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["component_count", "pending_count", "decided_count", "all_decisions_null"],
      "properties": {
        "component_count": { "const": 85 },
        "pending_count": { "type": "integer", "minimum": 0, "maximum": 85 },
        "decided_count": { "type": "integer", "minimum": 0, "maximum": 85 },
        "all_decisions_null": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["decision", "evidence_ref", "reviewer", "rationale"],
      "properties": {
        "decision": {
          "type": ["string", "null"],
          "enum": [null, "distinct", "merge_candidate", "reject_candidate", "needs_source_review"]
        },
        "evidence_ref": { "type": ["string", "null"] },
        "reviewer": { "type": ["string", "null"] },
        "rationale": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "type": "string" } } },
          "then": {
            "properties": {
              "evidence_ref": { "type": "string", "minLength": 1 },
              "reviewer": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "component_id",
        "priority_rank",
        "priority_key",
        "source_group",
        "unit_ids",
        "coverage",
        "collision_count",
        "review"
      ],
      "properties": {
        "component_id": { "type": "string", "pattern": "^component-[0-9]{4}$" },
        "priority_rank": { "type": "integer", "minimum": 1, "maximum": 85 },
        "priority_key": { "type": "object" },
        "source_group": { "enum": ["cards", "public_exams"] },
        "unit_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "coverage": { "type": "object" },
        "collision_count": { "type": "integer", "minimum": 1 },
        "review": { "$ref": "#/$defs/review" }
      },
      "additionalProperties": false
    }
  }
}
